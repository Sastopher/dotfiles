# Identity lives in ~/.gitconfig.local (untracked) so this file stays
# machine-agnostic. install.sh creates it interactively.
[include]
	path = ~/.gitconfig.local

[commit]
	verbose
[diff]
	colorMoved = default
	color = auto
[init]
	defaultBranch = main
[push]
	autoSetupRemote = true
[pull]
	rebase = true
[fetch]
	prune = true
[rerere]
	enabled = true
[column]
	ui = auto
[branch]
	sort = -committerdate
[alias]
	s = status
	d = diff --word-diff=color
	co = checkout
	a = add
	ai = add -i
	c = commit
[credential "https://github.com"]
	helper = 
	helper = !/opt/homebrew/bin/gh auth git-credential
[credential "https://gist.github.com"]
	helper = 
	helper = !/opt/homebrew/bin/gh auth git-credential
